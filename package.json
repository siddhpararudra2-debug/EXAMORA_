    "@types/supertest": "^7.2.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.5",
    "jest": "^30.4.2",
    "postcss": "^8.4.39",
    "prisma": "^5.17.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.6",
    "ts-jest": "^29.4.12",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
