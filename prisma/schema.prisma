generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ExamStatus {
  DRAFT
  PUBLISHED
  ACTIVE
  COMPLETED
  ARCHIVED

  @@map("exam_status")
}

enum QuestionType {
  MCQ_SINGLE
  MCQ_MULTI
  TRUE_FALSE
  SHORT_ANSWER
  LONG_ANSWER
  FILL_BLANK
  DROPDOWN
  LINEAR_SCALE
  CHECKBOX_GRID
  RADIO_GRID
  DATE
  FILE_UPLOAD

  @@map("question_type")
}

enum SubmissionStatus {
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED
  TERMINATED

  @@map("submission_status")
}

enum ViolationType {
  TAB_SWITCH
  APP_SWITCH
  MINIMIZE
  MOBILE_BUTTON
  AI_OVERLAY
  DEVTOOLS
  SCREEN_CAPTURE
  KEYBOARD_SHORTCUT
  /// Server-side evidence: the lockdown heartbeat went silent (client JS
  /// disabled, crashed, or the student left the tab). Recorded by the
  /// auto-submit sweep, not by the client.
  HEARTBEAT_TIMEOUT

  @@map("violation_type")
}

enum CreationMode {
  MANUAL
  UPLOAD
  AI_GENERATED

  @@map("creation_mode")
}

enum GradedBy {
  AUTO
  AI
  TEACHER

  @@map("graded_by")
}

enum EmailLogStatus {
  PENDING
  SENT
  FAILED

  @@map("email_log_status")
}

model Teacher {
  id                  String    @id @default(uuid())
  google_id           String?   @unique
  email               String
  name                String
  password_hash       String?   @db.VarChar(255)
  college_name        String?
  department          String?
  phone               String?
  reset_token         String?   @unique
  reset_token_expires DateTime?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt
  /// Soft-delete marker. Active rows are those with deleted_at IS NULL.
  /// Email uniqueness for active rows is enforced by a PARTIAL unique index
  /// (see migration 20260812000000_add_soft_deletes) so a deleted teacher
  /// can be re-registered without forcing a hard cascade wipe.
  deleted_at          DateTime?

  exams          Exam[]
  bank_questions BankQuestion[]

  @@index([deleted_at])
  @@map("teachers")
}

model Exam {
  id               String       @id @default(uuid())
  title            String
  description      String?
  subject          String?
  college_name     String?
  duration_minutes Int
  total_marks      Int
  creation_mode    CreationMode @default(MANUAL)
  access_uuid      String
  qr_code_url      String?
  start_time       DateTime?
  end_time         DateTime?
  settings         Json?        @db.JsonB
  status           ExamStatus   @default(DRAFT)
  published_at     DateTime?
  created_by       String
  creator          Teacher      @relation(fields: [created_by], references: [id], onDelete: Restrict)
  created_at       DateTime     @default(now())
  updated_at       DateTime     @updatedAt
  /// Soft-delete marker — deleting an exam only marks it archived; student
  /// sessions, questions and grades are retained for audit/recovery. Active
  /// access_uuid uniqueness is enforced by a partial unique index.
  deleted_at       DateTime?

  sections   Section[]
  questions  Question[]
  sessions   ExamSession[]
  email_logs EmailLog[]

  @@index([created_by])
  @@index([status])
  @@index([created_by, status])
  @@index([deleted_at])
  @@map("exams")
}

model Section {
  id               String   @id @default(uuid())
  exam_id          String
  exam             Exam     @relation(fields: [exam_id], references: [id], onDelete: Restrict)
  title            String
  description      String?
  order_index      Int
  duration_minutes Int?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
  deleted_at       DateTime?

  questions Question[]

  @@index([exam_id, order_index])
  @@index([deleted_at])
  @@map("sections")
}

model Question {
  id             String       @id @default(uuid())
  exam_id        String
  exam           Exam         @relation(fields: [exam_id], references: [id], onDelete: Restrict)
  section_id     String?
  section        Section?     @relation(fields: [section_id], references: [id], onDelete: SetNull)
  type           QuestionType
  question_text  String
  options        Json?
  correct_answer String?
  image_url      String?
  is_required    Boolean      @default(true)
  order_index    Int          @default(0)
  explanation    String?
  metadata       Json?        @db.JsonB
  marks          Int
  negative_marks Decimal      @default(0) @db.Decimal(5, 2)
  created_at     DateTime     @default(now())
  updated_at     DateTime     @updatedAt
  deleted_at     DateTime?

  answers Answer[]

  @@index([exam_id])
  @@index([section_id])
  @@index([exam_id, order_index])
  @@index([deleted_at])
  @@map("questions")
}

model ExamSession {
  id                String           @id @default(uuid())
  exam_id           String
  exam              Exam             @relation(fields: [exam_id], references: [id], onDelete: Restrict)
  session_token     String           @unique
  student_name      String
  enrollment_number String?
  student_email     String?
  status            SubmissionStatus @default(IN_PROGRESS)
  started_at        DateTime         @default(now())
  submitted_at      DateTime?
  expires_at        DateTime?
  total_score       Decimal?         @db.Decimal(10, 2)
  percentage        Decimal?         @db.Decimal(5, 2)
  /// Deterministic RNG seed used to shuffle questions/options per student.
  shuffle_seed      Int?
  /// Last time the student's browser reported the lockdown heartbeat.
  /// Stale heartbeats (client JS disabled/crashed) are flagged by the
  /// auto-submit sweep as server-side proctoring evidence.
  last_heartbeat_at DateTime?
  created_at        DateTime         @default(now())
  updated_at        DateTime         @updatedAt
  deleted_at        DateTime?

  answers    Answer[]
  violations Violation[]
  email_logs EmailLog[]

  @@index([exam_id])
  @@index([status])
  @@index([exam_id, status])
  @@index([exam_id, student_email, enrollment_number])
  @@index([last_heartbeat_at])
  @@index([deleted_at])
  @@map("exam_sessions")
}

model Answer {
  id               String      @id @default(uuid())
  session_id       String
  session          ExamSession @relation(fields: [session_id], references: [id], onDelete: Cascade)
  question_id      String
  question         Question    @relation(fields: [question_id], references: [id], onDelete: Cascade)
  answer_text      String
  is_correct       Boolean?
  marks_awarded    Decimal?    @db.Decimal(10, 2)
  graded_by        GradedBy?
  teacher_feedback String?
  ai_confidence    Decimal?    @db.Decimal(5, 4)
  /// True when the answer was flagged for manual teacher review (low AI confidence, file upload, or AI outage).
  needs_review     Boolean     @default(false)
  created_at       DateTime    @default(now())
  updated_at       DateTime    @updatedAt

  @@unique([session_id, question_id])
  @@index([question_id])
  @@map("answers")
}

model Violation {
  id          String        @id @default(uuid())
  session_id  String
  session     ExamSession   @relation(fields: [session_id], references: [id], onDelete: Cascade)
  type        ViolationType
  description String?
  metadata    Json?         @db.JsonB
  occurred_at DateTime      @default(now())

  @@index([session_id, occurred_at])
  @@map("violations")
}

model EmailLog {
  id              String         @id @default(uuid())
  exam_id         String
  exam            Exam           @relation(fields: [exam_id], references: [id], onDelete: Cascade)
  session_id      String?
  session         ExamSession?   @relation(fields: [session_id], references: [id], onDelete: Cascade)
  recipient_email String
  pdf_url         String?
  status          EmailLogStatus @default(PENDING)
  sent_at         DateTime?
  created_at      DateTime       @default(now())

  @@index([exam_id])
  @@index([session_id])
  @@index([status])
  @@map("email_log")
}

/// Teacher-owned question bank. Questions can be saved from an exam draft and
/// reused (copied) into any other exam — E16.
model BankQuestion {
  id             String       @id @default(uuid())
  teacher_id     String
  teacher        Teacher      @relation(fields: [teacher_id], references: [id], onDelete: Restrict)
  type           QuestionType
  question_text  String
  options        Json?
  correct_answer String?
  explanation    String?
  marks          Int
  negative_marks Decimal      @default(0) @db.Decimal(5, 2)
  metadata       Json?        @db.JsonB
  created_at     DateTime     @default(now())
  updated_at     DateTime     @updatedAt
  deleted_at     DateTime?

  @@index([teacher_id])
  @@index([type])
  @@index([deleted_at])
  @@map("bank_questions")
}
