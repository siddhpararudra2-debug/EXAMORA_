generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ExamStatus {
  DRAFT
  PUBLISHED
  ACTIVE
  COMPLETED
  ARCHIVED

  @@map("exam_status")
}

enum QuestionType {
  MCQ_SINGLE
  MCQ_MULTI
  TRUE_FALSE
  SHORT_ANSWER
  LONG_ANSWER
  FILL_BLANK
  DROPDOWN
  LINEAR_SCALE
  CHECKBOX_GRID
  RADIO_GRID
  DATE
  FILE_UPLOAD

  @@map("question_type")
}

enum SubmissionStatus {
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED
  TERMINATED

  @@map("submission_status")
}

enum ViolationType {
  TAB_SWITCH
  APP_SWITCH
  MINIMIZE
  MOBILE_BUTTON
  AI_OVERLAY
  DEVTOOLS
  SCREEN_CAPTURE
  KEYBOARD_SHORTCUT

  @@map("violation_type")
}

enum CreationMode {
  MANUAL
  UPLOAD
  AI_GENERATED

  @@map("creation_mode")
}

enum GradedBy {
  AUTO
  AI
  TEACHER

  @@map("graded_by")
}

enum EmailLogStatus {
  PENDING
  SENT
  FAILED

  @@map("email_log_status")
}

model Teacher {
  id           String   @id @default(uuid())
  google_id    String?  @unique
  email        String   @unique
  name         String
  password_hash String? @db.VarChar(255)
  college_name String?
  department   String?
  phone        String?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  exams        Exam[]

  @@map("teachers")
}

model Exam {
  id               String       @id @default(uuid())
  title            String
  description      String?
  subject          String?
  college_name     String?
  duration_minutes Int
  total_marks      Int
  creation_mode    CreationMode @default(MANUAL)
  access_uuid      String       @unique
  qr_code_url      String?
  start_time       DateTime?
  end_time         DateTime?
  settings         Json?        @db.JsonB
  status           ExamStatus   @default(DRAFT)
  published_at     DateTime?
  created_by       String
  creator          Teacher      @relation(fields: [created_by], references: [id], onDelete: Cascade)
  created_at       DateTime     @default(now())
  updated_at       DateTime     @updatedAt

  sections         Section[]
  questions        Question[]
  sessions         ExamSession[]
  email_logs       EmailLog[]

  @@index([created_by])
  @@index([status])
  @@map("exams")
}

model Section {
  id               String   @id @default(uuid())
  exam_id          String
  exam             Exam     @relation(fields: [exam_id], references: [id], onDelete: Cascade)
  title            String
  description      String?
  order_index      Int
  duration_minutes Int?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  questions        Question[]

  @@index([exam_id, order_index])
  @@map("sections")
}

model Question {
  id             String       @id @default(uuid())
  exam_id        String
  exam           Exam         @relation(fields: [exam_id], references: [id], onDelete: Cascade)
  section_id     String?
  section        Section?     @relation(fields: [section_id], references: [id], onDelete: SetNull)
  type           QuestionType
  question_text  String
  options        Json?
  correct_answer String?
  image_url      String?
  is_required    Boolean      @default(true)
  order_index    Int          @default(0)
  explanation    String?
  metadata       Json?        @db.JsonB
  marks          Int
  negative_marks Decimal      @default(0) @db.Decimal(5, 2)
  created_at     DateTime     @default(now())
  updated_at     DateTime     @updatedAt

  answers        Answer[]

  @@index([exam_id])
  @@index([section_id])
  @@index([exam_id, order_index])
  @@map("questions")
}

model ExamSession {
  id                String           @id @default(uuid())
  exam_id           String
  exam              Exam             @relation(fields: [exam_id], references: [id], onDelete: Cascade)
  session_token     String           @unique
  student_name      String
  enrollment_number String?
  student_email     String?
  status            SubmissionStatus @default(IN_PROGRESS)
  started_at        DateTime         @default(now())
  submitted_at      DateTime?
  total_score       Decimal?         @db.Decimal(10, 2)
  percentage        Decimal?         @db.Decimal(5, 2)
  created_at        DateTime         @default(now())
  updated_at        DateTime         @updatedAt

  answers           Answer[]
  violations        Violation[]
  email_logs        EmailLog[]

  @@index([exam_id])
  @@index([status])
  @@index([exam_id, student_email, enrollment_number])
  @@map("exam_sessions")
}

model Answer {
  id               String     @id @default(uuid())
  session_id       String
  session          ExamSession @relation(fields: [session_id], references: [id], onDelete: Cascade)
  question_id      String
  question         Question   @relation(fields: [question_id], references: [id], onDelete: Cascade)
  answer_text      String
  is_correct       Boolean?
  marks_awarded    Decimal?   @db.Decimal(10, 2)
  graded_by        GradedBy?
  teacher_feedback String?
  ai_confidence    Decimal?   @db.Decimal(5, 4)
  created_at       DateTime   @default(now())
  updated_at       DateTime   @updatedAt

  @@unique([session_id, question_id])
  @@index([question_id])
  @@map("answers")
}

model Violation {
  id          String        @id @default(uuid())
  session_id  String
  session     ExamSession   @relation(fields: [session_id], references: [id], onDelete: Cascade)
  type        ViolationType
  description String?
  metadata    Json?         @db.JsonB
  occurred_at DateTime      @default(now())

  @@index([session_id, occurred_at])
  @@map("violations")
}

model EmailLog {
  id              String         @id @default(uuid())
  exam_id         String
  exam            Exam           @relation(fields: [exam_id], references: [id], onDelete: Cascade)
  session_id      String?
  session         ExamSession?   @relation(fields: [session_id], references: [id], onDelete: Cascade)
  recipient_email String
  pdf_url         String?
  status          EmailLogStatus @default(PENDING)
  sent_at         DateTime?
  created_at      DateTime       @default(now())

  @@index([exam_id])
  @@index([session_id])
  @@index([status])
  @@map("email_log")
}
