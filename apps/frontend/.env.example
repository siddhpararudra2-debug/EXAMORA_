# Examora Frontend Environment Variables

# Base URL for Express backend REST API
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Socket.io Realtime Proctoring Server URL
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# NextAuth / Auth.js Configuration
AUTH_SECRET=your-32-byte-base64-secret-for-jwt-signing
AUTH_TRUST_HOST=true

# Database URL for Next.js SSR Prisma Client (if needed directly)
DATABASE_URL="postgresql://examora:examora_password@localhost:5432/examora_db?schema=public"

# AI Model CDN Base Override (Optional)
NEXT_PUBLIC_AI_MODEL_BASE_URL=https://cdn.jsdelivr.net/npm/@tensorflow-models/blazeface
