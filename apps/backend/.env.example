# Examora Backend Environment Variables

# Express Server Port & Environment
PORT=4000
NODE_ENV=development

# PostgreSQL Database Connection String
DATABASE_URL="postgresql://examora:examora_password@localhost:5432/examora_db?schema=public"

# Redis Connection (Optional, for Socket.io Pub/Sub Adapter & Rate Limiting)
REDIS_URL=redis://localhost:6379

# Allowed CORS Frontend URL
FRONTEND_URL=http://localhost:3000

# Authentication JWT Secret
JWT_SECRET=your-super-secret-jwt-key-change-in-production
SESSION_SECRET=your-session-secret-change-in-production
