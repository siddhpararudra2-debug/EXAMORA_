# Database
DATABASE_URL="postgresql://examora:examora_password@localhost:5432/examora_db?schema=public"

# Server
PORT=4000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Redis (optional, for Socket.io scaling)
REDIS_URL=redis://localhost:6379

# JWT Secret for authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Session secret
SESSION_SECRET=your-session-secret-change-in-production

# Auth.js (NextAuth v5) - used to sign the teacher session JWT
AUTH_SECRET=generate-a-32-byte-base64-secret
AUTH_TRUST_HOST=true