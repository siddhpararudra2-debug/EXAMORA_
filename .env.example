# Database
DATABASE_URL="postgresql://examora:examora_password@localhost:5432/examora_db?schema=public"

# Server
PORT=4000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Backend URL (must be set to the deployed Render backend's public URL in Vercel's project environment variables)
BACKEND_URL=http://localhost:4000

# Set to 1 when the backend runs behind a reverse proxy that forwards
# X-Forwarded-For (nginx / ingress). Keeps express-rate-limit keyed on the
# real client IP instead of the proxy's IP.
TRUST_PROXY=1

# Redis (optional, for Socket.io scaling)
REDIS_URL=redis://localhost:6379

# MVP privacy boundary: keep remote camera, snapshot, and audio supervision disabled.
# Set to true only after separate consent, retention, and access-control review.
ENABLE_REMOTE_MEDIA_SUPERVISION=false

# JWT Secret for authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Session secret
SESSION_SECRET=your-session-secret-change-in-production

# ── Email invites (Nodemailer — Gmail SMTP works out of the box) ──────────────
# In development (NODE_ENV != production), invite links are logged to the
# console instead of sent when SMTP_USER is empty.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="Examora Platform" <noreply@examora.edu>

# ── AI question generation (Groq cloud API or local open-source LLM) ───────────
# Cloud option: Groq API key (optional — free tier available)
GROQ_API_KEY=your-groq-api-key
# Open-source / local option: point to local Ollama / vLLM / LocalAI instance
# OLLAMA_HOST=http://localhost:11434
# LOCAL_LLM_URL=http://localhost:11434/v1
# LOCAL_LLM_MODEL=llama3


# ── AI document parsing service (FastAPI — PDF/DOCX/TXT → questions) ───────────
# Where the Express backend proxies /api/exams/parse-document uploads.
# `http://ai-service:5001` inside Docker Compose; http://localhost:5001 otherwise.
AI_SERVICE_URL=http://localhost:5001

# Shared secret between Express and the AI service. When set, the FastAPI
# service requires `Authorization: Bearer <key>` on every request except
# /health, and Express sends it automatically on /parse-document.
AI_SERVICE_API_KEY=change-me-in-production

# ── Uploads (optional — mounted as a Docker volume in production) ─────────────
UPLOADS_DIR=./uploads